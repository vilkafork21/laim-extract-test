                },
                {
                  "parameter": "distributive",
                  "label": "Точный distributive (обязательно, без шаблонов)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "",
                  "placeholder": "Полное значение из витрины"
                }
              ]
            }
          },
          {
            "type": "form",
            "label": "Текущий календарный период",
            "config": {
              "components": [
                {
                  "parameter": "test_date_from",
                  "label": "Первый день test, включительно (ГГГГ-ММ-ДД)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "",
                  "placeholder": "2026-08-01"
                },
                {
                  "parameter": "test_date_to",
                  "label": "Последний день test, включительно (ГГГГ-ММ-ДД)",
                  "uiComponent": "input",
                  "type": "string",
                  "defaultValue": "",
                  "placeholder": "2026-08-01"
                },
                {
                  "parameter": "tz",
                  "label": "Часовой пояс границ периода",
                  "uiComponent": "select",
                  "type": "string",
                  "allowedValues": [
                    {
                      "Москва (UTC+3)": "Europe/Moscow"
